# Base URL of the FastAPI scoring engine (backend/).
# When unset the frontend falls back to http://localhost:8000, and if the
# engine is unreachable it keeps the fixture scores (demo never breaks).
VITE_API_URL=http://localhost:8000

# VITE_DATA=real  → load the converted real network (public/real-graph.json)
#                   instead of the built-in fixture case. Generate it with:
#                   cd backend && python3 convert.py --source crimenet --limit 400 --out ../public/real-graph.json
VITE_DATA=
